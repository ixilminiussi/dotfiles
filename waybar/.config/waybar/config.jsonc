{
  "position": "top",
  "modules-left": ["cpu", "memory", "temperature", "battery", "hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["bluetooth", "pulseaudio", "backlight", "network", "clock"],

  "cpu": {
    "format": "  {usage}%",
  },
    
  "memory": {
    "format": "  {used:0.1f}GiB"
  },

  "temperature": {
    "format": "{icon} {temperatureC}°C",
    "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "format-icons": ["", "", "", "", ""],
    "critical-threshold": 80,
  },

  "clock": {
    "format": "󱑀  {:%I:%M %p}",
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<span color='#b4befe'>{}</span>",
        "days": "<span color='#cdd6fa'>{}</span>",
        "weekdays": "<span color='#f9e2af'>{}</span>",
        "today": "<span color='#f38ba8'><b>{}</b></span>"
      }
    }
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",   
      "default": ""  
    },
    "persistent-workspaces": {
      "*": 4
    },
    "active-only": false
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 20,
    "tooltip": false
  },
 
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-warning": "{icon} {capacity}%",
    "format-critical": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{icon} {time}",
    "format-full": "  {capacity}%",
    "format-icons": [" ", " ", " ", " ", " "],
    "tooltip-format": "{time}"
  },

  "network": {
    "format-alt": "{icon} {signalStrength}%",
    "format-wifi": "{icon} {essid}",
    "format-icons": ["󰤯 ", "󰤟 ", "󰤢 ", "󰤨 "], // low, medium, high
    "format-ethernet": "󰈀  Connected",
    "format-disconnected": "  Disconnected",
    "tooltip-format-wifi": "{essid}"
  },

  "bluetooth": {
    "on-click": "bluetoothctl power toggle",
    "on-click-right": "bluetoothctl devices | grep Connected",
  },

  "pulseaudio": {
    "format": "{icon} {volume}",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}",
    "format-icons": ["󰃞"],
  },

  "custom/caway": {
    "format": "{text}",
    "format-icons": {
      "Paused": "\uf04c ",
      "Stopped": "\uf04d "
    },
    "escape": true,
    "tooltip": true,
    "exec": "sh /home/ixilminiussi/.config/waybar/scripts/caway.sh -b 12 -f 60",
    "return-type": "json",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl previous",
    "on-scroll-down": "playerctl next",
    "on-click-right": "g4music",
    "max-length": 35
  },

  "custom/power": {
    "format": "{icon}",
    "tooltip": false,
    "on-click": "wlogout --protocol layer-shell"
  }
}
